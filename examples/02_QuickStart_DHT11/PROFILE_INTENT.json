{
  "name": "ESP32-C3 DHT11 QuickStart",
  "firmwareFamily": "iotlabs-quickstart-dht11",
  "controls": [
    {
      "name": "Temperature",
      "typeKey": "value",
      "access": "read",
      "config": {"unit": "C"}
    },
    {
      "name": "Humidity",
      "typeKey": "value",
      "access": "read",
      "config": {"unit": "%", "min": 0, "max": 100}
    }
  ]
}
